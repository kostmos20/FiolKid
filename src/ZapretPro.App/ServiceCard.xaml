<UserControl x:Class="ZapretPro.App.ServiceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="Transparent">
        <!-- Фон и рамка карточки отдельно от содержимого: в правом нижнем углу они «рассыпаются»
             на квадратики (маску задаёт код), а текст и кнопки остаются целыми -->
        <Border x:Name="Body" Style="{StaticResource Card}" Padding="0"/>

        <!-- Сияние и мозаика обрезаются по скруглённым углам карточки (обрезку задаёт код по размеру) -->
        <Grid x:Name="Inner" Margin="1">
                <!-- Мягкое сияние цвета сервиса за логотипом: дышит, пока подключаемся -->
                <Ellipse x:Name="Glow" Width="190" Height="190" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-60,-75,0,0" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="GlowColor" Color="#88EF4444" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <ScaleTransform/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Пиксельная мозаика цвета сервиса в правом нижнем углу: рассыпается из угла -->
                <!-- Холст нулевого размера в углу: мозаика рисуется от него вверх-влево и не раздувает карточку -->
                <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
                    <Canvas x:Name="Mosaic" IsHitTestVisible="False"/>
                </Canvas>

                <Grid Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <!-- Логотип-«неоновая трубка»: тонкая линия с мягким свечением своего цвета -->
                        <Viewbox x:Name="LogoBox" Width="38" Height="38" VerticalAlignment="Center">
                            <Viewbox.Effect>
                                <DropShadowEffect x:Name="LogoGlow" ShadowDepth="0" BlurRadius="10" Opacity="0" Color="#FFEF4444"/>
                            </Viewbox.Effect>
                        </Viewbox>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Строка состояния; если нужно действие — на её месте кнопка, чтобы карточка не росла
                         и не растягивала соседнюю в том же ряду -->
                    <StackPanel x:Name="StatusRow" Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                        <Ellipse x:Name="Dot" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" FontSize="18" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button x:Name="ActionButton" Grid.Row="1" Style="{StaticResource PillButton}" Margin="0,11,0,0"
                            HorizontalAlignment="Stretch" FontSize="15" Padding="12,4" Visibility="Collapsed"
                            Click="Action_Click"/>
                </Grid>
        </Grid>

        <!-- Новогоднее: снежная шапка лежит на верхнем крае и поднимается над ним — поэтому снаружи карточки -->
        <ContentControl x:Name="DriftHost" VerticalAlignment="Top" Margin="0,-19,0,0" IsHitTestVisible="False"
                        Visibility="Collapsed" Focusable="False"/>
    </Grid>
</UserControl>
