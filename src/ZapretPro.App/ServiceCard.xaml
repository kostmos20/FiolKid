<UserControl x:Class="ZapretPro.App.ServiceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="16,14">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#668B5CF6"/>
                        <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border x:Name="Badge" Width="40" Height="40" CornerRadius="12">
                    <TextBlock x:Name="GlyphText" FontSize="20" FontFamily="Segoe UI Symbol" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="{StaticResource MutedBrush}"
                               Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                <Ellipse x:Name="Dot" Width="12" Height="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" FontSize="18" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>

            <Button x:Name="ActionButton" Grid.Row="2" Style="{StaticResource PillButton}" Margin="0,12,0,0"
                    HorizontalAlignment="Stretch" FontSize="16" Padding="12,8" Visibility="Collapsed"
                    Click="Action_Click"/>
        </Grid>
    </Border>
</UserControl>
