<UserControl x:Class="ZapretPro.App.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- BasedOn — иначе свой стиль заменяет общий и текст становится чёрным по умолчанию -->
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <!-- Строка списка: слева название, справа результат замера -->
        <DataTemplate x:Key="ScoreRow">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Right}" FontSize="13" Foreground="{Binding RightBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding NoteVisibility}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,4,20,16">
            <TextBlock Text="Настройки" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <!-- Ключ Amnezia -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Ключ Amnezia" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Ключ из приложения Amnezia VPN, начинается с vpn://" Style="{StaticResource Hint}" Margin="0,4,0,12"/>
                    <DockPanel>
                        <Ellipse x:Name="KeyDot" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="KeyText" FontSize="17" Margin="8,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="PasteKeyButton" Style="{StaticResource PillButton}" Content="Вставить ключ" Margin="0,0,8,0"
                                Click="PasteKey_Click"/>
                        <Button x:Name="DeleteKeyButton" Style="{StaticResource SmallButton}" Content="Удалить" Click="DeleteKey_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Подписка -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Подписка" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Ссылка вида https://… со списком серверов (Швеция, Германия, Нидерланды…)" Style="{StaticResource Hint}"
                               Margin="0,4,0,12"/>
                    <DockPanel>
                        <Ellipse x:Name="SubscriptionDot" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SubscriptionText" FontSize="17" Margin="8,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="PasteSubscriptionButton" Style="{StaticResource PillButton}" Content="Вставить ссылку" Margin="0,0,8,0"
                                Click="PasteSubscription_Click"/>
                        <Button x:Name="DeleteSubscriptionButton" Style="{StaticResource SmallButton}" Content="Удалить"
                                Click="DeleteSubscription_Click"/>
                    </WrapPanel>

                    <StackPanel x:Name="ServersPanel" Margin="0,16,0,0">
                        <CheckBox x:Name="ServerAutoSwitch" Style="{StaticResource Switch}" Click="ServerAuto_Click">
                            <TextBlock Text="Сам выбирать самый быстрый сервер" FontSize="16" TextWrapping="Wrap"/>
                        </CheckBox>
                        <TextBlock x:Name="ServersHint" Style="{StaticResource Hint}" Margin="0,6,0,8"/>
                        <ListBox x:Name="ServersList" ItemContainerStyle="{StaticResource RowItem}" ItemTemplate="{StaticResource ScoreRow}"
                                 Background="Transparent" BorderThickness="0" MaxHeight="260"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ServersList_SelectionChanged"/>
                        <Button x:Name="MeasureServersButton" Style="{StaticResource SmallButton}" Content="Замерить серверы"
                                HorizontalAlignment="Left" Margin="0,8,0,0" Click="MeasureServers_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- VPN -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Подключение VPN" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Если вставлены и ключ, и подписка, программа сама берёт тот, что работает быстрее."
                               Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Ellipse x:Name="VpnDot" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VpnText" FontSize="18" Margin="8,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock x:Name="VpnHint" Style="{StaticResource Hint}" FontSize="15" Margin="0,6,0,0" Visibility="Collapsed"/>
                    <Button x:Name="ReconnectButton" Style="{StaticResource SmallButton}" Content="Проверить снова"
                            HorizontalAlignment="Left" Margin="0,14,0,0" Click="Reconnect_Click"/>
                </StackPanel>
            </Border>

            <!-- Альты zapret -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="YouTube и Discord: способ обхода" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Способов (альтов) много: одни работают быстрее, другие медленнее. Выбери, как подбирать."
                               Style="{StaticResource Hint}" Margin="0,4,0,10"/>
                    <WrapPanel>
                        <RadioButton x:Name="ModeFirst" Style="{StaticResource Segment}" GroupName="Mode" Content="Первый рабочий" Click="Mode_Click"/>
                        <RadioButton x:Name="ModeFastest" Style="{StaticResource Segment}" GroupName="Mode" Content="Самый быстрый" Click="Mode_Click"/>
                        <RadioButton x:Name="ModeManual" Style="{StaticResource Segment}" GroupName="Mode" Content="Выбрать вручную" Click="Mode_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="ModeHint" Style="{StaticResource Hint}" Margin="0,4,0,8"/>
                    <ListBox x:Name="StrategiesList" ItemContainerStyle="{StaticResource RowItem}" ItemTemplate="{StaticResource ScoreRow}"
                             Background="Transparent" BorderThickness="0" MaxHeight="300"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="StrategiesList_SelectionChanged"/>
                    <Button x:Name="BenchmarkButton" Style="{StaticResource SmallButton}" Content="Замерить скорость альтов"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Click="Benchmark_Click"/>
                </StackPanel>
            </Border>

            <!-- Telegram -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Telegram" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="TelegramText" FontSize="16" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource PillButton}" Content="Подключить Telegram" Margin="0,0,8,8" Click="ConnectTelegram_Click"/>
                        <Button x:Name="RestartProxyButton" Style="{StaticResource SmallButton}" Content="Перезапустить прокси" Margin="0,0,0,8"
                                Click="RestartProxy_Click"/>
                    </WrapPanel>
                    <TextBlock Text="«Подключить» открывает Telegram и предлагает добавить прокси — нажми там «Подключить». Если Telegram закрыт, он откроется сам."
                               Style="{StaticResource Hint}"/>
                </StackPanel>
            </Border>

            <!-- Запуск и журнал -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Оформление, запуск и отчёты" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="NewYearSwitch" Style="{StaticResource Switch}" Margin="0,12,0,0" Click="NewYear_Click">
                        <TextBlock Text="Новогоднее оформление: снег, гирлянда и таймер" FontSize="16" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" Margin="0,12,0,0" Click="Autostart_Click">
                        <TextBlock Text="Запускать вместе с Windows (сразу возле часов)" FontSize="16" TextWrapping="Wrap"/>
                    </CheckBox>
                    <TextBlock x:Name="LogPathText" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                    <Button x:Name="SaveReportButton" Style="{StaticResource SmallButton}" Content="Сохранить отчёт на рабочий стол"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Click="SaveReport_Click"/>
                </StackPanel>
            </Border>

            <!-- Обновления и версии -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Обновления" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="UpdateStatusText" FontSize="16" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="UpdateNotesText" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="Collapsed"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="InstallUpdateButton" Style="{StaticResource PillButton}" Content="Обновить" Margin="0,0,8,8"
                                Visibility="Collapsed" Click="InstallUpdate_Click"/>
                        <Button x:Name="CheckUpdateButton" Style="{StaticResource SmallButton}" Content="Проверить обновления" Margin="0,0,0,8"
                                Click="CheckUpdate_Click"/>
                    </WrapPanel>
                    <TextBlock Text="Обновления берутся только с официальной страницы программы на GitHub и проверяются по подписи автора. Ключ, подписка и настройки при обновлении сохраняются."
                               Style="{StaticResource Hint}"/>

                    <TextBlock Text="Что внутри" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0"/>
                    <ItemsControl x:Name="VersionsList" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Item2}" FontSize="14"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="220"
                                               TextAlignment="Right"/>
                                    <TextBlock Text="{Binding Item1}" FontSize="15"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Список заблокированных сайтов обновляется сам раз в сутки."
                               Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
