<Window x:Class="ZapretPro.App.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подробности — FiolKid" Width="760" Height="640"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}" FontFamily="Segoe UI">
    <!-- Техническое окно для внука: состояние без упрощений и журнал. Бабушке сюда заходить незачем. -->
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="CheckButton" Style="{StaticResource SecondaryButton}" Content="Проверить сейчас" Click="Check_Click"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Скопировать журнал" Margin="8,0,0,0" Click="Copy_Click"/>
            </StackPanel>
            <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"
                     Background="{StaticResource CardBrush}" Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource CardBorderBrush}" Padding="10" Margin="0,0,0,12"/>
            <TextBlock Text="Журнал" FontSize="15" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
        </StackPanel>
        <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12" Background="{StaticResource CardBrush}"
                 Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource CardBorderBrush}"/>
    </DockPanel>
</Window>
