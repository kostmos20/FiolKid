<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Только ради значка в трее (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FiolKid</AssemblyName>
    <RootNamespace>ZapretPro.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\fiolkid.ico</ApplicationIcon>
    <Version>0.9.8</Version>
    <Product>FiolKid</Product>
  </PropertyGroup>

  <!-- Публикация: один self-contained exe, бабушке не нужно ставить .NET -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Иначе имена WinForms (Application, MessageBox, Brushes…) путаются с WPF -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Значок программы: tools\make-icon.ps1 -->
  <ItemGroup>
    <Resource Include="Assets\fiolkid.ico" />
    <Resource Include="Assets\fiolkid-256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZapretPro.Core\ZapretPro.Core.csproj" />
  </ItemGroup>

</Project>
