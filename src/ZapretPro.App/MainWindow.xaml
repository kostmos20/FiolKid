<Window x:Class="ZapretPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZapretPro.App"
        Title="FiolKid" Width="500" Height="820" Icon="Assets/fiolkid.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        WindowStyle="None" AllowsTransparency="False"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Вкладка внизу окна: значок над подписью, выбранная подсвечивается -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="14" Padding="0,8" Margin="4,0">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Фон: три мягких цветных пятна медленно плывут (анимация — в MainWindow.xaml.cs) -->
        <Canvas x:Name="Aurora" Grid.RowSpan="3" ClipToBounds="True" IsHitTestVisible="False">
            <Ellipse x:Name="BlobA" Width="520" Height="520" Canvas.Left="-200" Canvas.Top="-140" Opacity="0.55">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#557C3AED" Offset="0"/>
                        <GradientStop Color="#007C3AED" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="BlobB" Width="460" Height="460" Canvas.Left="210" Canvas.Top="260" Opacity="0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#443B82F6" Offset="0"/>
                        <GradientStop Color="#003B82F6" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="BlobC" Width="420" Height="420" Canvas.Left="-120" Canvas.Top="520" Opacity="0.45">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#44EC4899" Offset="0"/>
                        <GradientStop Color="#00EC4899" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <!-- Заголовок окна -->
        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Style="{StaticResource CloseChromeButton}" Content="&#xE8BB;"
                    ToolTip="Спрятать возле часов (программа продолжит работать)" Click="Close_Click"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click"/>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="Assets/fiolkid-256.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="FiolKid" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource LavenderBrush}"/>
                <TextBlock x:Name="VersionText" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <Ellipse x:Name="TitleDot" Width="7" Height="7" Margin="10,0,0,0" Fill="{StaticResource GrayBrush}"/>
            </StackPanel>
        </DockPanel>

        <!-- Страницы. Смена вкладки — с плавным появлением -->
        <Grid x:Name="Pages" Grid.Row="1">
            <!-- Главная -->
            <Grid x:Name="HomePage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Кнопка питания и общее состояние -->
                <StackPanel Margin="0,8,0,0">
                    <Grid Width="240" Height="240" HorizontalAlignment="Center">
                        <!-- Расходящееся кольцо: «идёт работа» -->
                        <Ellipse x:Name="PulseRing" Width="240" Height="240" StrokeThickness="3" Opacity="0"
                                 Stroke="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="0.86" ScaleY="0.86"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Бегущая дуга вокруг кнопки, пока подбираю или проверяю -->
                        <Ellipse x:Name="SpinRing" Width="214" Height="214" StrokeThickness="4" Opacity="0"
                                 StrokeDashArray="18 34" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFC4B5FD" Offset="0"/>
                                    <GradientStop Color="#FF7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                            <Ellipse.RenderTransform>
                                <RotateTransform/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <Button x:Name="PowerButton" Width="190" Height="190" Cursor="Hand" Click="Power_Click"
                                ToolTip="Включить или выключить" RenderTransformOrigin="0.5,0.5">
                            <Button.RenderTransform>
                                <ScaleTransform/>
                            </Button.RenderTransform>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse x:Name="Glow" Fill="#FF1A2233" Stroke="#FF2A3550" StrokeThickness="2">
                                            <Ellipse.Effect>
                                                <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.0" Color="#FF8B5CF6"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Ellipse x:Name="Face" Margin="14">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop x:Name="FaceTop" Color="#FF334155" Offset="0"/>
                                                    <GradientStop x:Name="FaceBottom" Color="#FF1E293B" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <!-- Блик сверху — объём -->
                                        <Ellipse Margin="44,20,44,118" IsHitTestVisible="False">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#1FFFFFFF" Offset="0"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Face" Property="Opacity" Value="0.92"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="56"
                                           HorizontalAlignment="Center" Foreground="White"/>
                                <TextBlock x:Name="PowerLabel" Text="ВКЛЮЧИТЬ" FontSize="17" FontWeight="Bold" Margin="0,10,0,0"
                                           HorizontalAlignment="Center" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="Headline" Text="Выключено" FontSize="28" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock x:Name="Subline" Text="Нажми на кнопку, чтобы включить" FontSize="17"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="30,6,30,0"/>
                </StackPanel>

                <!-- Сервисы -->
                <Grid x:Name="Cards" Grid.Row="1" Margin="20,18,20,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <local:ServiceCard x:Name="YouTubeCard" Grid.Row="0" Grid.Column="0" Title="YouTube" Glyph="▶" BadgeBrush="#FFE11D2A"/>
                    <local:ServiceCard x:Name="DiscordCard" Grid.Row="0" Grid.Column="2" Title="Discord" Glyph="🎧" BadgeBrush="#FF5865F2"/>
                    <local:ServiceCard x:Name="TelegramCard" Grid.Row="2" Grid.Column="0" Title="Telegram" Glyph="✈" BadgeBrush="#FF229ED9"/>
                    <local:ServiceCard x:Name="AiCard" Grid.Row="2" Grid.Column="2" Title="Нейросети" Subtitle="и другие сайты" Glyph="✦"
                                       BadgeBrush="#FF8B5CF6"/>
                </Grid>
            </Grid>

            <local:LogPage x:Name="LogTab" Visibility="Collapsed"/>
            <local:SettingsPage x:Name="SettingsTab" Visibility="Collapsed"/>
        </Grid>

        <!-- Вкладки -->
        <Border Grid.Row="2" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8,12,10"
                Background="#661A2233">
            <Grid>
                <!-- Светящаяся полоска над выбранной вкладкой, переезжает при переключении -->
                <Border x:Name="TabIndicator" Height="3" Width="44" CornerRadius="2" VerticalAlignment="Top" HorizontalAlignment="Left"
                        Margin="0,-9,0,0" Background="{StaticResource AccentGradient}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="TabIndicatorShift"/>
                    </Border.RenderTransform>
                </Border>
                <UniformGrid x:Name="TabBar" Columns="3">
                    <Button x:Name="HomeTabButton" Style="{StaticResource TabButton}" Click="HomeTab_Click">
                        <StackPanel>
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Главная" FontSize="14" Margin="0,4,0,0" HorizontalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LogTabButton" Style="{StaticResource TabButton}" Click="LogTab_Click">
                        <StackPanel>
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Журнал" FontSize="14" Margin="0,4,0,0" HorizontalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsTabButton" Style="{StaticResource TabButton}" Click="SettingsTab_Click">
                        <StackPanel>
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Настройки" FontSize="14" Margin="0,4,0,0" HorizontalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Всплывающая подсказка снизу («Отчёт скопирован» и т. п.) -->
        <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="20,0,20,16" Padding="18,12" CornerRadius="14" Background="#F02A2050" Opacity="0"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" Y="0"/>
            </Border.RenderTransform>
            <TextBlock x:Name="ToastText" FontSize="16" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
    </Grid>
</Window>
