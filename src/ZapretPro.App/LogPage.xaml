<UserControl x:Class="ZapretPro.App.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Вкладка «Журнал»: что происходит на самом деле и кнопка, чтобы прислать отчёт -->
    <DockPanel Margin="20,4,20,0">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Журнал" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Если что-то не работает — скопируй отчёт и пришли тому, кто помогает с программой."
                       FontSize="15" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource PillButton}" Content="Скопировать отчёт" Click="Copy_Click"/>
                <Button x:Name="CheckButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Проверить сейчас"
                        Click="Check_Click"/>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
                <TextBlock x:Name="DetailsText" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}"/>
            </Border>
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="4">
            <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource MutedBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
