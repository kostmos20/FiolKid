<UserControl x:Class="ZapretPro.App.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Вкладка «Журнал»: что происходит на самом деле и кнопки, чтобы прислать отчёт -->
    <DockPanel Margin="20,4,20,0">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Журнал" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Если что-то не работает — скопируй отчёт и пришли тому, кто помогает с программой. Ключей и ссылок в отчёте нет."
                       FontSize="15" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>
            <WrapPanel Margin="0,0,0,12">
                <Button x:Name="CopyButton" Style="{StaticResource PillButton}" Content="Скопировать отчёт" Margin="0,0,8,8" Click="Copy_Click"/>
                <Button x:Name="SaveButton" Style="{StaticResource SecondaryButton}" Content="В файл" Margin="0,0,8,8"
                        Click="Save_Click" ToolTip="Сохранить отчёт на рабочий стол — если скопировать не получается"/>
                <Button x:Name="CheckButton" Style="{StaticResource SecondaryButton}" Content="Проверить" Margin="0,0,0,8"
                        Click="Check_Click" ToolTip="Проверить YouTube, Discord, Telegram и нейросети прямо сейчас"/>
            </WrapPanel>

            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
                <TextBlock x:Name="DetailsText" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}"/>
            </Border>
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="4">
            <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{Binding Brush}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
