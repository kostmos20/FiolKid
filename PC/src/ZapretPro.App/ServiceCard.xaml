<UserControl x:Class="ZapretPro.App.ServiceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="Transparent">
        <!-- Плитка — готовая картинка со снежной шапкой (макет Codex): серая, пока сервис не работает,
             и с подсветкой его цвета, когда работает. Она шире и выше карточки — снег и свечение выходят за край -->
        <Image x:Name="PlateImage" Source="Assets/winter/card-off.png" Stretch="Fill" Margin="-7,-44,-7,-46"
               IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>

        <StackPanel Margin="18,25,18,0">
            <StackPanel Orientation="Horizontal">
                <!-- Логотип-«неоновая трубка»: серый, а у включённого — цвета сервиса со свечением -->
                <Viewbox x:Name="LogoBox" Width="29" Height="29" VerticalAlignment="Center">
                    <Viewbox.Effect>
                        <DropShadowEffect x:Name="LogoGlow" ShadowDepth="1" BlurRadius="2" Opacity="0.55" Color="Black"/>
                    </Viewbox.Effect>
                </Viewbox>
                <TextBlock x:Name="TitleText" Margin="10,0,0,1" FontSize="18" FontWeight="SemiBold" Foreground="#FFF3F1EC"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="DescriptionText" Margin="0,8,0,0" FontSize="11" Foreground="#FFC4C4CC"/>

            <!-- Строка состояния; если нужно действие — на её месте кнопка, чтобы карточка не росла -->
            <StackPanel x:Name="StatusRow" Orientation="Horizontal" Margin="0,15,0,0">
                <Ellipse x:Name="Dot" Width="5" Height="5" VerticalAlignment="Center" Fill="#FF9296A0"/>
                <TextBlock x:Name="StatusText" FontSize="12" Margin="6,0,0,1" Foreground="#FFC8C8D0" VerticalAlignment="Center"/>
            </StackPanel>

            <Button x:Name="ActionButton" Height="29" Margin="0,10,0,0" Cursor="Hand" Visibility="Collapsed" Click="Action_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" BorderBrush="#4FB59462" BorderThickness="1" Padding="9,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#A3645343" Offset="0"/>
                                    <GradientStop Color="#D9413D39" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <DockPanel>
                                <Path DockPanel.Dock="Right" Data="m9 5 7 7-7 7" Stroke="#FFE7CFAB" StrokeThickness="1.6" Width="12" Height="12"
                                      Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF726048"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock x:Name="ActionText" FontSize="12" FontWeight="Medium" Foreground="#FFE7CFAB"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
