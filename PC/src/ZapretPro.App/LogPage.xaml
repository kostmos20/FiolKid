<UserControl x:Class="ZapretPro.App.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Значки кнопок (контур, как у вкладок) -->
        <Style x:Key="ButtonIcon" TargetType="Path">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>

        <!-- Фильтр ленты: «Все / Важное / Ошибки» -->
        <Style x:Key="Filter" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFAEB2BF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Padding="9,6" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20C2A071"/>
                                <Setter Property="Foreground" Value="#FFEAD1AC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка ленты: без подсветки выбора, с тонкой чертой снизу -->
        <Style x:Key="EventItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border BorderBrush="#06FFFFFF" BorderThickness="0,0,0,1" Padding="0,12">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Вкладка «Журнал»: кнопки отчёта, короткая сводка и лента событий -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,0,24,20">
            <TextBlock Text="СОСТОЯНИЕ И СОБЫТИЯ" FontSize="10" FontWeight="SemiBold" Foreground="#FFC9B397" Margin="0,0,0,10"/>
            <TextBlock Text="Журнал" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock FontSize="12.5" Foreground="#FFC1C0C7" Margin="0,10,0,20" LineHeight="20" TextWrapping="Wrap"
                       Text="Всё, что происходит с подключением.&#10;Если нужна помощь — отправь отчёт."/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CopyButton" Style="{StaticResource PillButton}" Click="Copy_Click"
                        ToolTip="Скопировать отчёт и вставить его в сообщение. Ключей и ссылок в отчёте нет">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ButtonIcon}" Data="M10 7h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2ZM15 7V3H4v13h4"/>
                        <TextBlock x:Name="CopyText" Text="Скопировать отчёт"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="11,8"
                        Click="Save_Click" ToolTip="Сохранить отчёт на рабочий стол — если скопировать не получается">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ButtonIcon}" Data="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"/>
                        <TextBlock Text="В файл"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CheckButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="11,8"
                        Click="Check_Click" ToolTip="Проверить YouTube, Discord, Telegram и нейросети прямо сейчас">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ButtonIcon}" Data="M20 10a8 8 0 1 0-2 8M20 4v6h-6"/>
                        <TextBlock Text="Проверить"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Подключение: итог, значок состояния, четыре сервиса и подробная сводка под раскрытием -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Border x:Name="Badge" DockPanel.Dock="Right" VerticalAlignment="Center" CornerRadius="16" Padding="10,6"
                                Background="#07FFFFFF" BorderBrush="#0EFFFFFF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="BadgeDot" Width="5" Height="5" VerticalAlignment="Center" Fill="{StaticResource GrayBrush}"/>
                                <TextBlock x:Name="BadgeText" FontSize="11" Margin="6,0,0,1" Foreground="#FFC4C6D0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="ПОДКЛЮЧЕНИЕ" FontSize="10" FontWeight="SemiBold" Foreground="#FFB6B3B9"/>
                            <TextBlock x:Name="ConnectionTitle" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                    <UniformGrid x:Name="ServicePills" Columns="4" Margin="-3,16,-3,0"/>
                    <Border BorderBrush="#0CFFFFFF" BorderThickness="0,1,0,0" Margin="0,13,0,0" Padding="0,11,0,0">
                        <Expander Style="{StaticResource Disclosure}" Header="Техническая сводка">
                            <TextBlock x:Name="DetailsText" FontFamily="Consolas" FontSize="11" LineHeight="18" TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                        </Expander>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Лента событий -->
            <Border Style="{StaticResource Card}" Padding="17">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="7" Padding="7,3" Background="#12BFA37E" BorderBrush="#15BFA37E"
                                BorderThickness="1">
                            <TextBlock x:Name="EventCount" FontSize="11" Foreground="#FFC3B69F"/>
                        </Border>
                        <TextBlock Text="Лента событий" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <DockPanel Margin="0,14,0,4">
                        <Border DockPanel.Dock="Left" CornerRadius="9" Padding="3" Background="#5C171B24" BorderBrush="#06FFFFFF"
                                BorderThickness="1" Margin="0,0,9,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="FilterAll" Style="{StaticResource Filter}" GroupName="LogFilter" Content="Все"
                                             IsChecked="True" Click="Filter_Click"/>
                                <RadioButton x:Name="FilterImportant" Style="{StaticResource Filter}" GroupName="LogFilter" Content="Важное"
                                             Click="Filter_Click" ToolTip="Предупреждения и ошибки"/>
                                <RadioButton x:Name="FilterErrors" Style="{StaticResource Filter}" GroupName="LogFilter" Content="Ошибки"
                                             Click="Filter_Click"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <TextBox x:Name="SearchBox" Height="32" FontSize="11.5" Foreground="#FFE8E7E5" CaretBrush="#FFE8E7E5"
                                     VerticalContentAlignment="Center" TextChanged="Search_TextChanged">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border CornerRadius="8" Background="#52191E28" BorderBrush="#0DFFFFFF" BorderThickness="1" Padding="7,0">
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <TextBlock x:Name="SearchHint" Text="Найти событие…" FontSize="11.5" Foreground="#FF9A9FAB" Margin="10,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </DockPanel>

                    <ListBox x:Name="LogList" MaxHeight="300" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource EventItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="10.5" Foreground="#FF929AAA" Margin="0,2,0,0"/>
                                    <Ellipse Grid.Column="1" Width="6" Height="6" Fill="{Binding Mark}" VerticalAlignment="Top"
                                             HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium" Foreground="{Binding TitleBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#FFA9AEBC" Margin="0,3,0,0" LineHeight="17"
                                                   TextWrapping="Wrap" Visibility="{Binding DetailVisibility}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyEvents" Margin="0,24,0,16" Visibility="Collapsed">
                        <Path Data="M8 3h10a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3ZM5 7H3m2 5H3m2 5H3m6-10h7m-7 5h7m-7 5h4"
                              Stroke="#FFB7A382" StrokeThickness="1.4" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <TextBlock Text="Здесь спокойно" FontSize="14" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="Событий по этому фильтру нет." FontSize="11.5" Foreground="#FFAAB0BE" HorizontalAlignment="Center"
                                   Margin="0,7,0,10"/>
                        <Button HorizontalAlignment="Center" Cursor="Hand" Click="ShowAll_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock Text="Показать все события" FontSize="11.5" Foreground="#FFDEC198" TextDecorations="Underline"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <DockPanel Margin="0,8,0,0">
                        <Border DockPanel.Dock="Top" BorderBrush="#0BFFFFFF" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Path Data="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6ZM8 12l3 3 5-6" Stroke="#FFACBBA9" StrokeThickness="1.6"
                                  Width="11" Height="11" Stretch="Uniform" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Без ключей и ссылок" FontSize="10.5" Foreground="#FF9299A7" Margin="5,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="LastCheckText" FontSize="10.5" Foreground="#FF9299A7"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
