<Window x:Class="ZapretPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZapretPro.App"
        Title="FiolKid" Width="500" Height="824" Icon="Assets/fiolkid.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        WindowStyle="None" AllowsTransparency="False"
        Background="#FF18191F" FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="43" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- Зимнее оформление по макету Codex (Codex/…/FiolKid-Design): картинки в Assets/winter,
         размеры и цвета — из его style.css и image-theme.css -->
    <Window.Resources>
        <SolidColorBrush x:Key="WinterText" Color="#FFF3F1EC"/>
        <SolidColorBrush x:Key="WinterSub" Color="#FFDBD5CF"/>
        <SolidColorBrush x:Key="WinterWarm" Color="#FFEBD2AD"/>
        <SolidColorBrush x:Key="WinterNav" Color="#FFB3B7C4"/>

        <!-- Вкладка внизу: значок над подписью, у выбранной — тёплый цвет и чёрточка снизу -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource WinterNav}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Width="105" MinHeight="58">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavIcon" TargetType="Path">
            <Setter Property="Width" Value="21"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="43"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="83"/>
        </Grid.RowDefinitions>

        <!-- Фон: зимняя улица и затемнение книзу, чтобы текст и плитки читались -->
        <Rectangle x:Name="Scene" Grid.RowSpan="3" IsHitTestVisible="False">
            <Rectangle.Effect>
                <BlurEffect x:Name="SceneBlur" Radius="0"/>
            </Rectangle.Effect>
            <Rectangle.Fill>
                <ImageBrush ImageSource="Assets/winter/background.jpg" Stretch="UniformToFill" AlignmentY="Center"/>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Grid.RowSpan="3" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#61121219" Offset="0"/>
                    <GradientStop Color="#4D15141B" Offset="0.15"/>
                    <GradientStop Color="#A318171E" Offset="0.39"/>
                    <GradientStop Color="#DB17171E" Offset="0.62"/>
                    <GradientStop Color="#F716171E" Offset="0.91"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- На «Журнале» и «Настройках» улица уходит в тень, чтобы панели читались -->
        <Rectangle x:Name="SubShade" Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#BB191B26" Offset="0"/>
                    <GradientStop Color="#ED1B1D27" Offset="0.35"/>
                    <GradientStop Color="#FA171B25" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Новогоднее: гирлянда над всеми вкладками (на главной — ярче) -->
        <Canvas x:Name="Garland" Grid.Row="1" Height="34" Margin="16,2,16,0" VerticalAlignment="Top" IsHitTestVisible="False"/>

        <!-- Заголовок окна -->
        <Border Grid.Row="0" Background="#80171923" BorderBrush="#07FFFFFF" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource CloseChromeButton}" Content="&#xE8BB;" Foreground="#FFD4D0CC"
                        ToolTip="Спрятать возле часов (программа продолжит работать)" Click="Close_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Content="&#xE921;" Foreground="#FFD4D0CC" Click="Minimize_Click"/>
                <StackPanel Orientation="Horizontal" Margin="17,0,0,0" VerticalAlignment="Center">
                    <Path Data="M16 3v12M9 7.3a12 12 0 1 0 14 0" Stroke="#FFDFCEB0" StrokeThickness="2" Width="17" Height="17" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <TextBlock Text="FiolKid" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource WinterText}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="VersionText" Margin="7,1,0,0" FontSize="11" Foreground="#FFB8B5B9" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Страницы. Смена вкладки — с плавным появлением -->
        <Grid x:Name="Pages" Grid.Row="1">
            <!-- Главная: всё по координатам макета (верх страницы = 43 пикселя от верха окна) -->
            <Canvas x:Name="HomePage">
                <!-- Новогоднее: таймер до Нового года -->
                <StackPanel x:Name="NewYearPanel" Width="500" Canvas.Top="43">
                    <Border HorizontalAlignment="Center" Padding="13,6" CornerRadius="16"
                            Background="#8C24212B" BorderBrush="#2BE3D3B8" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✧" FontSize="15" Foreground="#FFE2BD82" VerticalAlignment="Center" Margin="0,-2,7,0"/>
                            <TextBlock x:Name="CountdownText" FontSize="11.5" Foreground="#FFEBE1D1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Главное состояние и кнопка -->
                <StackPanel Canvas.Top="147" Width="500">
                    <TextBlock x:Name="Headline" Text="Выключено" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{StaticResource WinterText}">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="16" Opacity="0.6" Color="Black"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="Subline" Text="Нажми на кнопку, чтобы включить FiolKid." FontSize="13" Margin="30,9,30,0"
                               Foreground="{StaticResource WinterSub}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.7" Color="Black"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Кнопка-картинка: у выключенной — приглушённая копия. Подпись поверх, правее значка -->
                    <Button x:Name="PowerButton" Width="218" Height="65" Margin="0,25,0,0" Cursor="Hand" Click="Power_Click"
                            ToolTip="Включить или выключить" RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <TranslateTransform x:Name="PowerShift"/>
                        </Button.RenderTransform>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <Image x:Name="Plate" Source="Assets/winter/button-off.png" Stretch="Fill" Margin="-9,-8,-9,-8"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <ContentPresenter/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Plate" Property="Opacity" Value="0.92"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <TextBlock x:Name="PowerLabel" Text="Включить" FontSize="16" FontWeight="SemiBold" Foreground="#FFF4EEE3"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,0,1"/>
                            <!-- Огонёк справа (в картинке он жёлтый): мигает, пока подключаемся, зелёный — когда работает -->
                            <Ellipse x:Name="ButtonLight" Width="6" Height="6" HorizontalAlignment="Right" Margin="0,0,9,0" Opacity="0">
                                <Ellipse.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="0.8" Color="#FFB3C8AC"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Сервисы -->
                <Grid Canvas.Left="24" Canvas.Top="332" Width="452">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="1,0,1,0">
                        <TextBlock x:Name="ServicesSummary" DockPanel.Dock="Right" Text="Всё в одном месте" FontSize="10.5"
                                   Foreground="#FFC2BAB0" VerticalAlignment="Center"/>
                        <TextBlock Text="Твои сервисы" FontSize="13" FontWeight="SemiBold" Foreground="#FFE6DFD4"/>
                    </DockPanel>

                    <Grid x:Name="Cards" Grid.Row="1" Margin="0,27,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="132"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="132"/>
                        </Grid.RowDefinitions>
                        <local:ServiceCard x:Name="YouTubeCard" Grid.Row="0" Grid.Column="0" Title="YouTube" Logo="YouTube"
                                           Description="Видео и трансляции" Plate="youtube" Accent="#FFEF8278"/>
                        <local:ServiceCard x:Name="DiscordCard" Grid.Row="0" Grid.Column="2" Title="Discord" Logo="Discord"
                                           Description="Голос и сообщества" Plate="discord" Accent="#FFB4A3FF"/>
                        <local:ServiceCard x:Name="TelegramCard" Grid.Row="2" Grid.Column="0" Title="Telegram" Logo="Telegram"
                                           Description="Сообщения и звонки" Plate="telegram" Accent="#FF83CEFA"/>
                        <local:ServiceCard x:Name="AiCard" Grid.Row="2" Grid.Column="2" Title="VPN" Logo="Stars"
                                           Description="Нейросети и другие сайты" Plate="vpn" Accent="#FFF1D16D"/>
                    </Grid>
                </Grid>

                <!-- Тихая строка внизу; если вышло обновление — на её месте ссылка «Обновить» -->
                <StackPanel x:Name="QuietFooter" Canvas.Top="674" Width="500" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Grid Width="500">
                        <StackPanel x:Name="FooterQuiet" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="m5 12 4 4L19 6" Stroke="#FFA3B4AA" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"/>
                            <TextBlock Text="Привычные сайты работают как обычно" FontSize="11" Foreground="#FFB6B8C2" Margin="6,0,0,0"/>
                        </StackPanel>
                        <Button x:Name="UpdateButton" Visibility="Collapsed" HorizontalAlignment="Center" Cursor="Hand" Click="Update_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="UpdateText" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFEBD2AD" TextDecorations="Underline"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Canvas>

            <local:LogPage x:Name="LogTab" Margin="0,36,0,17" Visibility="Collapsed"/>
            <local:SettingsPage x:Name="SettingsTab" Margin="0,36,0,17" Visibility="Collapsed"/>
        </Grid>

        <!-- Вкладки: тёмная панель со снежной шапкой сверху -->
        <Border Grid.Row="2" BorderBrush="#18D6DFEC" BorderThickness="0,1,0,0" Padding="24,9,24,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF242630" Offset="0"/>
                    <GradientStop Color="#FF191C25" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Image x:Name="TabSnow" Source="Assets/winter/snow-cap.png" Stretch="Fill" Height="170" VerticalAlignment="Top"
                       Margin="-29,-45,-29,0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleY="0.55"/>
                    </Image.RenderTransform>
                    <Image.Effect>
                        <DropShadowEffect ShadowDepth="4" Direction="270" BlurRadius="4" Opacity="0.3" Color="#FF020811"/>
                    </Image.Effect>
                </Image>
                <UniformGrid x:Name="TabBar" Columns="3" VerticalAlignment="Center">
                    <Button x:Name="HomeTabButton" Style="{StaticResource TabButton}" Click="HomeTab_Click">
                        <Grid>
                            <StackPanel>
                                <Path Style="{StaticResource NavIcon}" Data="m3 10 9-7 9 7M5.5 9v11h5v-6h3v6h5V9"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Главная" FontSize="10.5" Margin="0,7,0,0" HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                            <Border x:Name="HomeMark" Width="15" Height="2" CornerRadius="1" Background="#FFCDA76C"
                                    VerticalAlignment="Bottom" Margin="0,0,0,-7"/>
                        </Grid>
                    </Button>
                    <Button x:Name="LogTabButton" Style="{StaticResource TabButton}" Click="LogTab_Click">
                        <Grid>
                            <StackPanel>
                                <Path Style="{StaticResource NavIcon}" Data="M8 3h10a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3ZM5 7H3m2 5H3m2 5H3m6-10h7m-7 5h7m-7 5h4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Журнал" FontSize="10.5" Margin="0,7,0,0" HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                            <Border x:Name="LogMark" Width="15" Height="2" CornerRadius="1" Background="#FFCDA76C"
                                    VerticalAlignment="Bottom" Margin="0,0,0,-7" Visibility="Hidden"/>
                        </Grid>
                    </Button>
                    <Button x:Name="SettingsTabButton" Style="{StaticResource TabButton}" Click="SettingsTab_Click">
                        <Grid>
                            <StackPanel>
                                <Path Style="{StaticResource NavIcon}"
                                      Data="m10 3-.6 2.5L7 6.8 4.5 6 3 8.6l1.8 1.8v3.2L3 15.4 4.5 18l2.5-.8 2.4 1.3.6 2.5h3l.6-2.5 2.4-1.3 2.5.8 1.5-2.6-1.8-1.8v-3.2L20 8.6 18.5 6l-2.5.8-2.4-1.3L13 3ZM14.5 12a3 3 0 1 1-6 0a3 3 0 1 1 6 0Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Настройки" FontSize="10.5" Margin="0,7,0,0" HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                            <Border x:Name="SettingsMark" Width="15" Height="2" CornerRadius="1" Background="#FFCDA76C"
                                    VerticalAlignment="Bottom" Margin="0,0,0,-7" Visibility="Hidden"/>
                        </Grid>
                    </Button>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Новогоднее: снег падает по всему окну, поверх всего, но не мешает нажимать -->
        <Canvas x:Name="Snow" Grid.RowSpan="3" ClipToBounds="True" IsHitTestVisible="False"/>

        <!-- Всплывающая подсказка снизу («Отчёт скопирован» и т. п.) -->
        <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="22,0,22,24" Padding="16,13" CornerRadius="12" Background="#F535343E" Opacity="0"
                BorderBrush="#18FFFFFF" BorderThickness="1" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" Y="0"/>
            </Border.RenderTransform>
            <TextBlock x:Name="ToastText" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource WinterText}"/>
        </Border>
    </Grid>
</Window>
